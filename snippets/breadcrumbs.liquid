{% assign template_base = template | split: '.' | first %}

{% unless template_base == 'index'
  or template_base == 'article'
  or template_base == 'customers/login'
  or template_base == 'customers/register'
  or template_base == 'product'
  or template_base == '404'
%}
  <div class="container">
    <nav id="breadcrumbs" class="breadcrumb body-small" role="navigation" aria-label="breadcrumbs">
      
      <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
        {{- 'general.breadcrumbs.home' | t -}}
      </a>

      {% assign menu_handle = 'main-menu' %}
      {% assign current_path = request.path %}
      {% assign found_in_menu = false %}

      {% if template contains 'page' %}
        {% for link in linklists[menu_handle].links %}
          {% if found_in_menu == false %}
            
            {% if link.url == current_path %}
              {% assign found_in_menu = true %}
              <div class="breadcrumb__delimiter"></div>
              <span>{{ link.title }}</span>
            {% else %}
              {% for child_link in link.links %}
                {% if child_link.url == current_path %}
                  {% assign found_in_menu = true %}
                  <div class="breadcrumb__delimiter"></div>
                  <a href="{{ link.url }}" class="focus-inset">{{ link.title }}</a>
                  <div class="breadcrumb__delimiter"></div>
                  <span>{{ child_link.title }}</span>
                {% else %}
                  {% for grandchild_link in child_link.links %}
                    {% if grandchild_link.url == current_path %}
                      {% assign found_in_menu = true %}
                      <div class="breadcrumb__delimiter"></div>
                      <a href="{{ link.url }}" class="focus-inset">{{ link.title }}</a>
                      <div class="breadcrumb__delimiter"></div>
                      <a href="{{ child_link.url }}" class="focus-inset">{{ child_link.title }}</a>
                      <div class="breadcrumb__delimiter"></div>
                      <span>{{ grandchild_link.title }}</span>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endif %}

          {% endif %}
        {% endfor %}
        
        {% if found_in_menu == false %}
          <div class="breadcrumb__delimiter"></div>
          <span>{{ page.title }}</span>
        {% endif %}

      {% elsif template == 'cart' %}
        <div class="breadcrumb__delimiter"></div>
        <span>{{ 'sections.cart.title' | t }}</span>

      {% elsif template contains 'product' %}
        <div class="breadcrumb__delimiter"></div>
        {% if product.collections[0] %}
          <a href="{{ product.collections[0].url }}" class="focus-inset">{{ product.collections[0].title }}</a>
          <div class="breadcrumb__delimiter"></div>
        {% endif %}
        <span>{{ product.title }}</span>

      {% elsif template == 'blog' %}
        <div class="breadcrumb__delimiter"></div>
        {% if current_tags %}
          {{ blog.title | link_to: blog.url }}
          <div class="breadcrumb__delimiter"></div>
          <span>{{ current_tags | join: ' + ' }}</span>
        {% else %}
          <span>{{ blog.title }}</span>
        {% endif %}

      {% elsif template contains 'collection' %}
        <div class="breadcrumb__delimiter"></div>
        {% if template contains 'list-collections' %}
          <span>{{ page_title }}</span>
        {% else %}
          <span>{{ collection.title }}</span>
        {% endif %}

      {% elsif template == 'customers/order' %}
        <div class="breadcrumb__delimiter"></div>
        <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }}</a>
        <div class="breadcrumb__delimiter"></div>
        <span>{{ order.name }}</span>

      {% elsif template == 'customers/addresses' %}
        <div class="breadcrumb__delimiter"></div>
        <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }}</a>
        <div class="breadcrumb__delimiter"></div>
        <span>{{ 'customer.addresses.title' | t }}</span>

      {% else %}
        <div class="breadcrumb__delimiter"></div>
        <span>{{ page_title }}</span>
      {% endif %}
    </nav>

    <script>
      const calcBreadcrumbs = () => {
        const breadcrumbs = document.querySelector('.breadcrumb');
        if (breadcrumbs) {
          const breadcrumbsObserver = new ResizeObserver((entries) => {
            const breadcrumbsHeight = breadcrumbs.getBoundingClientRect().height;
            document.documentElement.style.setProperty('--breadcrumbs-height', `${breadcrumbsHeight + 24}px`);
          });
          breadcrumbsObserver.observe(breadcrumbs);
        }
      };
      calcBreadcrumbs();

      document.addEventListener('shopify:section:load', function () {
        calcBreadcrumbs();
      });
    </script>
  </div>
{% endunless %}