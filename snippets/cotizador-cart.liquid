{%- comment -%}
  Cotizador Cart — Snippet for Cart Drawer & Cart Page
  Renders a "Cotizar orden" button and modal to generate a
  leasing quote PDF for all items in the cart.

  El arriendo aplica cuando el carrito tiene al menos un dispositivo
  elegible: iPhone, iPad, Mac Desktop (iMac / Mac mini / Mac Studio /
  Mac Pro) o Mac Notebook (MacBook Air / MacBook Pro). En ese caso
  TODO el carrito entra al arriendo: dispositivos con su factor y
  accesorios con la tasa 'Otros'. Sin dispositivos, la cotización
  es solo de venta (sin cuota).

  Usage:
    {% render 'cotizador-cart' %}
{%- endcomment -%}

{% render 'arriendo-config' %}

{%- style -%}
/* ── BOTÓN COTIZAR CART ────────────────────────────── */
.qcot-cart-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 12px 20px;
  margin: 8px 0 0;
  background: transparent;
  color: #0071e3;
  border: 2px solid #0071e3;
  border-radius: 12px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: background 0.2s, color 0.2s, transform 0.1s;
  -webkit-font-smoothing: antialiased;
}
.qcot-cart-btn:hover { background: #0071e3; color: #fff; }
.qcot-cart-btn:active { transform: scale(0.98); }
.qcot-cart-btn svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }

/* ── BOTÓN FULL-WIDTH CART PAGE ───────────────────────── */
.qcotc-page-btn-wrap {
  max-width: 1200px;
  margin: 24px auto;
  padding: 0 20px;
}
.qcotc-page-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 24px;
  background: #0071e3;
  color: #fff;
  border: none;
  border-radius: 12px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.01em;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  -webkit-font-smoothing: antialiased;
}
.qcotc-page-btn:hover { background: #0077ed; }
.qcotc-page-btn:active { transform: scale(0.98); }
.qcotc-page-btn svg { width: 20px; height: 20px; fill: currentColor; flex-shrink: 0; }

/* ── OVERLAY + MODAL ───────────────────────────────── */
.qcotc-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  z-index: 99998;
  opacity: 0; visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}
.qcotc-overlay.qcotc-open { opacity: 1; visibility: visible; }

.qcotc-modal {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.95);
  width: min(480px, calc(100vw - 32px));
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  background: #fff;
  border-radius: 20px;
  z-index: 99999;
  overflow-x: hidden;
  opacity: 0; visibility: hidden;
  transition: opacity 0.3s, transform 0.3s, visibility 0.3s;
  box-shadow: 0 24px 80px rgba(0,0,0,0.25);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}
.qcotc-overlay.qcotc-open + .qcotc-modal,
.qcotc-modal.qcotc-open {
  opacity: 1; visibility: visible; transform: translate(-50%, -50%) scale(1);
}

body.qcotc-header-under .shopify-section-header,
body.qcotc-header-under .section-announcement {
  z-index: -1 !important;
}

/* Modal internals */
.qcotc-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 24px 12px;
}
.qcotc-header h3 { margin: 0; font-size: 18px; font-weight: 700; color: #1d1d1f; }
.qcotc-close {
  background: none; border: none; cursor: pointer; padding: 4px;
  color: #86868b; font-size: 22px; line-height: 1;
}
.qcotc-close:hover { color: #1d1d1f; }

.qcotc-body { padding: 0 24px 20px; }

/* Cart summary in modal */
.qcotc-summary {
  background: #f5f5f7; border-radius: 12px; padding: 14px 16px; margin-bottom: 16px;
}
.qcotc-summary-title {
  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;
  text-transform: uppercase; color: #86868b; margin: 0 0 10px;
}
.qcotc-item {
  display: flex; align-items: center; gap: 10px;
  padding: 6px 0;
  border-bottom: 1px solid #e5e5e7;
}
.qcotc-item:last-of-type { border-bottom: none; }
.qcotc-item-img {
  width: 40px; height: 40px; border-radius: 6px; object-fit: cover;
  background: #fff; border: 1px solid #e5e5e7; flex-shrink: 0;
}
.qcotc-item-info { flex: 1; min-width: 0; }
.qcotc-item-name {
  font-size: 12px; font-weight: 600; color: #1d1d1f;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.qcotc-item-variant { font-size: 11px; color: #86868b; }
.qcotc-item-soloventa { font-size: 10px; color: #b25000; }
.qcotc-item-price { font-size: 12px; font-weight: 600; color: #1d1d1f; white-space: nowrap; }

/* Editable quantity stepper */
.qcotc-qty-wrap {
  display: flex; align-items: center; gap: 0;
  border: 1.5px solid #d2d2d7; border-radius: 8px;
  overflow: hidden; flex-shrink: 0; height: 30px;
}
.qcotc-qty-btn {
  width: 28px; height: 30px; border: none; background: #f5f5f7;
  font-size: 16px; font-weight: 600; color: #1d1d1f; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-family: inherit; transition: background 0.15s; padding: 0; line-height: 1;
}
.qcotc-qty-btn:hover { background: #e8e8ed; }
.qcotc-qty-btn:active { background: #d2d2d7; }
.qcotc-qty-input {
  width: 38px; height: 30px; border: none; border-left: 1px solid #d2d2d7;
  border-right: 1px solid #d2d2d7; text-align: center; font-size: 13px;
  font-weight: 600; color: #1d1d1f; background: #fff; font-family: inherit;
  -moz-appearance: textfield; padding: 0;
}
.qcotc-qty-input::-webkit-inner-spin-button,
.qcotc-qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
.qcotc-item-right { display: flex; align-items: center; gap: 10px; }

.qcotc-total-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 0 0; margin-top: 6px;
}
.qcotc-total-label { font-size: 13px; font-weight: 600; color: #1d1d1f; }
.qcotc-total-value { font-size: 15px; font-weight: 700; color: #0071e3; }

/* Lease preview */
.qcotc-lease-preview {
  background: #0071e3; color: #fff; border-radius: 12px;
  padding: 14px 16px; margin-bottom: 16px; text-align: center;
}
.qcotc-lease-label { font-size: 11px; color: #fff !important; opacity: 0.85; margin: 0 0 4px; }
.qcotc-lease-cuota { font-size: 22px; font-weight: 700; color: #fff !important; margin: 0; }
.qcotc-lease-sub { font-size: 11px; color: #fff !important; opacity: 0.7; margin: 4px 0 0; }

/* Form fields */
.qcotc-form-group { margin-bottom: 12px; }
.qcotc-label {
  display: block; font-size: 11px; font-weight: 600;
  letter-spacing: 0.05em; text-transform: uppercase;
  color: #86868b; margin-bottom: 4px;
}
.qcotc-input {
  width: 100%; padding: 10px 14px;
  background: #f5f5f7; border: 1.5px solid transparent;
  border-radius: 10px; font-size: 14px; color: #1d1d1f;
  font-family: inherit; outline: none;
  transition: border 0.2s, background 0.2s;
  box-sizing: border-box;
}
.qcotc-input:focus { background: #fff; border-color: #0071e3; }
.qcotc-input-error { border-color: #ff3b30 !important; }
.qcotc-error-msg {
  color: #ff3b30; font-size: 11px; margin-top: 3px;
  display: none;
}
.qcotc-error-msg.qcotc-show { display: block; }

.qcotc-name-row { display: flex; gap: 10px; }
.qcotc-name-row .qcotc-form-group { flex: 1; }

/* Submit button */
.qcotc-submit {
  width: 100%; padding: 14px;
  background: #0071e3; color: #fff; border: none;
  border-radius: 12px; font-size: 15px; font-weight: 600;
  font-family: inherit; cursor: pointer;
  transition: background 0.2s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.qcotc-submit:hover { background: #0077ed; }
.qcotc-submit:disabled { opacity: 0.6; cursor: not-allowed; }
.qcotc-submit svg { width: 18px; height: 18px; fill: currentColor; }

.qcotc-disclaimer {
  text-align: center; font-size: 10px; color: #86868b;
  margin-top: 10px; line-height: 1.4;
}

/* Success state */
.qcotc-success {
  text-align: center; padding: 30px 10px;
  display: none;
}
.qcotc-success.qcotc-show { display: block; }
.qcotc-success-check {
  font-size: 36px; color: #34c759; margin-bottom: 10px;
}
.qcotc-success h4 { font-size: 17px; font-weight: 700; color: #1d1d1f; margin: 0 0 6px; }
.qcotc-success p { font-size: 13px; color: #86868b; margin: 0; }

/* Spinner */
.qcotc-spinner {
  display: inline-block; width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff; border-radius: 50%;
  animation: qcotcSpin 0.6s linear infinite;
}
@keyframes qcotcSpin { to { transform: rotate(360deg); } }

/* Plazo toggle */
.qcotc-plazo-row {
  display: flex; gap: 8px; margin-bottom: 14px;
}
.qcotc-plazo-opt {
  flex: 1; padding: 10px 8px; border-radius: 10px;
  border: 2px solid #e5e5e7; background: #fff;
  text-align: center; cursor: pointer; transition: all 0.2s;
  font-family: inherit;
}
.qcotc-plazo-opt.qcotc-plazo-active {
  border-color: #0071e3; background: #f0f7ff;
}
.qcotc-plazo-opt-months { font-size: 14px; font-weight: 700; color: #1d1d1f; display: block; }
{%- endstyle -%}

<!-- Banner de encabezado para el PDF (logo MacOnline + partners) -->
<img id="qcotc-shop-logo" src="https://cdn.shopify.com/s/files/1/0731/0757/0884/files/cotizador-header.png?v=1788384404" alt="" crossorigin="anonymous" style="display:none;">

<!-- Cart Page: full-width button below cart (only on /cart page) -->
{%- if request.page_type == 'cart' -%}
<div class="qcotc-page-btn-wrap">
  <button type="button" class="qcotc-page-btn" id="qcotc-trigger-page">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
    Descargar cotización en PDF
  </button>
</div>
{%- endif -%}

<!-- Cotizar Cart Button — will be injected into drawer via JS -->
<template id="qcotc-btn-template">
  <button type="button" class="qcot-cart-btn" id="qcotc-trigger">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
    Descargar cotización en PDF
  </button>
</template>

<!-- Overlay + Modal -->
<div class="qcotc-overlay" id="qcotc-overlay"></div>
<div class="qcotc-modal" id="qcotc-modal">
  <div class="qcotc-header">
    <h3>Cotizar orden</h3>
    <button class="qcotc-close" id="qcotc-close">&times;</button>
  </div>
  <div class="qcotc-body">
    <!-- Cart summary (populated by JS) -->
    <div class="qcotc-summary" id="qcotc-summary"></div>

    <!-- Plazo toggle (solo visible si hay equipos elegibles para arriendo) -->
    <div class="qcotc-plazo-row" id="qcotc-plazo-row">
      <button type="button" class="qcotc-plazo-opt" data-plazo="12">
        <span class="qcotc-plazo-opt-months">12 meses</span>
      </button>
      <button type="button" class="qcotc-plazo-opt" data-plazo="24">
        <span class="qcotc-plazo-opt-months">24 meses</span>
      </button>
      <button type="button" class="qcotc-plazo-opt qcotc-plazo-active" data-plazo="36">
        <span class="qcotc-plazo-opt-months">36 meses</span>
      </button>
    </div>

    <!-- Lease preview (populated by JS) -->
    <div class="qcotc-lease-preview" id="qcotc-lease-box">
      <p class="qcotc-lease-label">Cuota mensual estimada (IVA incluido)</p>
      <p class="qcotc-lease-cuota" id="qcotc-lease-cuota">—</p>
      <p class="qcotc-lease-sub" id="qcotc-lease-sub"></p>
    </div>

    <!-- Form -->
    <div id="qcotc-form-area">
      <div class="qcotc-name-row">
        <div class="qcotc-form-group">
          <label class="qcotc-label" for="qcotc-nombre">Nombre</label>
          <input class="qcotc-input" type="text" id="qcotc-nombre" placeholder="Juan" autocomplete="given-name">
        </div>
        <div class="qcotc-form-group">
          <label class="qcotc-label" for="qcotc-apellido">Apellido</label>
          <input class="qcotc-input" type="text" id="qcotc-apellido" placeholder="Pérez" autocomplete="family-name">
        </div>
      </div>
      <div class="qcotc-form-group">
        <label class="qcotc-label" for="qcotc-empresa">Empresa</label>
        <input class="qcotc-input" type="text" id="qcotc-empresa" placeholder="Mi Empresa SpA" autocomplete="organization">
      </div>
      <div class="qcotc-form-group">
        <label class="qcotc-label" for="qcotc-rut">RUT Empresa</label>
        <input class="qcotc-input" type="text" id="qcotc-rut" placeholder="76.123.456-7" autocomplete="off">
      </div>
      <div class="qcotc-name-row">
        <div class="qcotc-form-group">
          <label class="qcotc-label" for="qcotc-telefono">Teléfono *</label>
          <input class="qcotc-input" type="tel" id="qcotc-telefono" placeholder="+56 9 1234 5678" autocomplete="tel">
          <div class="qcotc-error-msg" id="qcotc-telefono-error">Ingresa un número de teléfono válido</div>
        </div>
        <div class="qcotc-form-group">
          <label class="qcotc-label" for="qcotc-email">Email corporativo *</label>
          <input class="qcotc-input" type="email" id="qcotc-email" placeholder="juan@empresa.cl" required autocomplete="email">
          <div class="qcotc-error-msg" id="qcotc-email-error">Ingresa un email válido</div>
        </div>
      </div>

      <button type="button" class="qcotc-submit" id="qcotc-submit-btn">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        Descargar cotización PDF
      </button>

      <p class="qcotc-disclaimer">Al descargar, aceptas recibir información sobre nuestros productos y servicios.</p>
    </div>

    <!-- Success state -->
    <div class="qcotc-success" id="qcotc-success">
      <div class="qcotc-success-check">✓</div>
      <h4>Cotización descargada</h4>
      <p>Revisa tu carpeta de descargas. Te contactaremos pronto.</p>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  /* ── Load jsPDF ──────────────────────────────────── */
  if (!window.jspdf) {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js';
    s.onerror = function() { console.error('[CotizadorCart] Failed to load jsPDF'); };
    document.head.appendChild(s);
  }

  /* ── Constants ───────────────────────────────────── */
  /* Parámetros centralizados (factores por tipo, IVA) */
  var CFG = window.ArriendoConfig;
  var APP_PROXY_URL = '/apps/cotizador';
  var shopName = {{ shop.name | json }};
  var currentPlazo = CFG.PLAZO_DEFAULT;
  var cartItems = []; /* populated from /cart.js */

  /* ── Format helpers ───────────────────────────────── */
  function fmtMiles(n) { return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function fmtDate() {
    var d = new Date();
    var months = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
    return d.getDate() + ' de ' + months[d.getMonth()] + ' de ' + d.getFullYear();
  }
  function fmtDateShort() {
    var d = new Date();
    return d.getDate().toString().padStart(2,'0') + '/' + (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getFullYear();
  }
  function addDays(days) {
    var d = new Date();
    d.setDate(d.getDate() + days);
    return d.getDate().toString().padStart(2,'0') + '/' + (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getFullYear();
  }
  function isValidEmail(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email); }

  /* ── Elegibilidad de arriendo operativo ──────────────────
     Solo estos tipos de producto aplican a arriendo:
     iPhone, iPad, Mac Desktop y Mac Notebook.
     El resto de productos se cotiza solo para venta. */
  function clasificarArriendo(productType) {
    var t = (productType || '').trim();
    if (t.indexOf('iPhone') === 0) return 'iPhone';
    if (t.indexOf('iPad') === 0) return 'iPad';
    if (t.indexOf('MacBook') === 0) return 'Mac Notebook';
    if (t.indexOf('iMac') === 0 || t === 'Mac mini' || t === 'Mac Studio' || t === 'Mac Pro') return 'Mac Desktop';
    return null;
  }

  function detectTipo(title, productType) {
    return clasificarArriendo(productType) || productType || 'Accesorio';
  }

  function hayDispositivo() {
    return cartItems.some(function(it) { return it.esDispositivo; });
  }

  /* Cuota neta por línea. Los dispositivos usan su factor propio;
     los accesorios que acompañan a un dispositivo usan la tasa
     'Otros'. */
  function calcCuotaItem(it, plazo) {
    var tipo = it.esDispositivo ? it.tipo : 'Otros';
    return CFG.cuotaNeta(it.priceNet * it.qty, plazo, tipo);
  }

  /* Con al menos un dispositivo elegible (iPhone/iPad/Mac) en el
     carrito, TODOS los items entran al arriendo (accesorios con
     tasa 'Otros'). Sin dispositivos, no hay arriendo. */
  function itemsArriendo() {
    return hayDispositivo() ? cartItems.slice() : [];
  }

  /* ── Inject button near totals ───────────────────────── */
  function injectButton() {
    var template = document.getElementById('qcotc-btn-template');
    if (!template) return;

    /* Cart Drawer: after .cart-drawer__footer .totals or before checkout button */
    var drawerFooter = document.querySelector('.cart-drawer__footer');
    if (drawerFooter && !drawerFooter.querySelector('#qcotc-trigger-drawer')) {
      var clone1 = template.content.cloneNode(true);
      var btn1 = clone1.querySelector('.qcot-cart-btn');
      btn1.id = 'qcotc-trigger-drawer';
      /* Place after the .cart-drawer__footer div that contains totals */
      var innerFooter = drawerFooter.querySelector('.cart-drawer__footer');
      if (innerFooter) {
        /* Nested .cart-drawer__footer div — place after it */
        innerFooter.parentNode.insertBefore(clone1, innerFooter.nextSibling);
      } else {
        /* Try placing after totals div */
        var totalsDiv = drawerFooter.querySelector('.totals');
        if (totalsDiv && totalsDiv.parentNode) {
          totalsDiv.parentNode.insertBefore(clone1, totalsDiv.nextSibling);
        } else {
          drawerFooter.appendChild(clone1);
        }
      }
    }

    /* Cart Page: button is rendered server-side (Liquid), no JS injection needed */

    /* Attach click handlers to all cotizador buttons (drawer + page) */
    document.querySelectorAll('.qcot-cart-btn, .qcotc-page-btn').forEach(function(btn) {
      if (!btn._qcotcBound) {
        btn._qcotcBound = true;
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (btn.id === 'qcotc-trigger-drawer') {
            document.body.classList.add('qcotc-opened-from-drawer');
          } else {
            document.body.classList.remove('qcotc-opened-from-drawer');
          }
          openModal();
        });
      }
    });
  }

  /* ── Modal open/close ──────────────────────────────── */
  var overlay = document.getElementById('qcotc-overlay');
  var modal = document.getElementById('qcotc-modal');
  var closeBtn = document.getElementById('qcotc-close');
  var formArea = document.getElementById('qcotc-form-area');
  var successArea = document.getElementById('qcotc-success');
  var overlapNodes = [];
  var overlapOriginalZ = [];

  function collectOverlapNodes() {
    var nodes = [];
    var header = document.querySelector('.shopify-section-header');
    var announcement = document.querySelector('.section-announcement');
    if (header) nodes.push(header);
    if (announcement) nodes.push(announcement);
    return nodes;
  }

  function lowerOverlapLayers() {
    overlapNodes = collectOverlapNodes();
    overlapOriginalZ = overlapNodes.map(function(node) { return node.style.zIndex; });
    overlapNodes.forEach(function(node) {
      node.style.setProperty('z-index', '-1', 'important');
    });
    document.body.classList.add('qcotc-header-under');
  }

  function restoreOverlapLayers() {
    overlapNodes.forEach(function(node, idx) {
      var original = overlapOriginalZ[idx];
      if (original) {
        node.style.zIndex = original;
      } else {
        node.style.removeProperty('z-index');
      }
    });
    document.body.classList.remove('qcotc-header-under');
    overlapNodes = [];
    overlapOriginalZ = [];
  }

  function openModal() {
    formArea.style.display = '';
    successArea.classList.remove('qcotc-show');
    lowerOverlapLayers();
    /* Refresh cart data, then show modal */
    fetchCart().then(function() {
      renderSummary();
      updateLease();
      overlay.classList.add('qcotc-open');
      modal.classList.add('qcotc-open');
      document.body.style.overflow = 'hidden';
    });
  }
  function closeModal() {
    overlay.classList.remove('qcotc-open');
    modal.classList.remove('qcotc-open');
    document.body.style.overflow = '';
    restoreOverlapLayers();
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);

  /* ── Fetch cart ───────────────────────────────────── */
  function fetchCart() {
    return fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        cartItems = cart.items.map(function(item) {
          return {
            id: item.id,
            variantId: item.variant_id,
            sku: item.sku || '',
            title: item.product_title,
            variantTitle: item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '',
            qty: item.quantity,
            /* item.price YA incluye IVA (taxesIncluded); se deriva el neto */
            priceNet: (item.price / 100) / CFG.IVA,
            priceBruto: item.price / 100,
            image: item.featured_image ? item.featured_image.url : '',
            handle: item.handle,
            tipo: detectTipo(item.product_title, item.product_type),
            esDispositivo: clasificarArriendo(item.product_type) !== null
          };
        });
        return cartItems;
      });
  }

  /* ── Render cart summary in modal ──────────────────────── */
  function renderSummary() {
    var container = document.getElementById('qcotc-summary');
    var html = '<p class="qcotc-summary-title">Productos a cotizar (' + cartItems.length + ')</p>';
    var totalNet = 0;

    for (var i = 0; i < cartItems.length; i++) {
      var it = cartItems[i];
      /* Precios mostrados siempre con IVA incluido */
      var lineTotal = it.priceBruto * it.qty;
      totalNet += lineTotal;
      html += '<div class="qcotc-item">';
      if (it.image) {
        html += '<img class="qcotc-item-img" src="' + it.image + '&width=80" alt="">';
      }
      html += '<div class="qcotc-item-info">';
      html += '<div class="qcotc-item-name">' + it.title + '</div>';
      if (it.variantTitle) {
        html += '<div class="qcotc-item-variant">' + it.variantTitle + '</div>';
      }
      if (!it.esDispositivo) {
        if (hayDispositivo()) {
          html += '<div class="qcotc-item-variant">Arriendo con tasa accesorio</div>';
        } else {
          html += '<div class="qcotc-item-soloventa">Solo venta — no aplica arriendo</div>';
        }
      }
      html += '</div>';
      html += '<div class="qcotc-item-right">';
      html += '<div class="qcotc-qty-wrap">';
      html += '<button type="button" class="qcotc-qty-btn" data-action="minus" data-idx="' + i + '">−</button>';
      html += '<input type="number" class="qcotc-qty-input" data-idx="' + i + '" value="' + it.qty + '" min="1" max="999">';
      html += '<button type="button" class="qcotc-qty-btn" data-action="plus" data-idx="' + i + '">+</button>';
      html += '</div>';
      html += '<div class="qcotc-item-price" id="qcotc-line-price-' + i + '">$' + fmtMiles(lineTotal) + '</div>';
      html += '</div>';
      html += '</div>';
    }

    html += '<div class="qcotc-total-row">';
    html += '<span class="qcotc-total-label">Total (IVA incluido)</span>';
    html += '<span class="qcotc-total-value" id="qcotc-total-value">$' + fmtMiles(totalNet) + '</span>';
    html += '</div>';

    container.innerHTML = html;
    bindQtyEvents();
  }

  /* ── Quantity stepper event handlers ───────────────────── */
  function bindQtyEvents() {
    /* +/- buttons */
    document.querySelectorAll('.qcotc-qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.getAttribute('data-idx'), 10);
        var input = document.querySelector('.qcotc-qty-input[data-idx="' + idx + '"]');
        var current = parseInt(input.value, 10) || 1;
        if (btn.getAttribute('data-action') === 'minus') {
          current = Math.max(1, current - 1);
        } else {
          current = Math.min(999, current + 1);
        }
        input.value = current;
        cartItems[idx].qty = current;
        recalcTotals();
      });
    });
    /* Direct input */
    document.querySelectorAll('.qcotc-qty-input').forEach(function(input) {
      input.addEventListener('input', function() {
        var idx = parseInt(input.getAttribute('data-idx'), 10);
        var val = parseInt(input.value, 10);
        if (isNaN(val) || val < 1) val = 1;
        if (val > 999) val = 999;
        cartItems[idx].qty = val;
        recalcTotals();
      });
      input.addEventListener('blur', function() {
        var idx = parseInt(input.getAttribute('data-idx'), 10);
        if (!input.value || parseInt(input.value, 10) < 1) {
          input.value = 1;
          cartItems[idx].qty = 1;
          recalcTotals();
        }
      });
    });
  }

  /* ── Recalculate line prices + total + lease ────────────── */
  function recalcTotals() {
    var totalNet = 0;
    for (var i = 0; i < cartItems.length; i++) {
      var lineTotal = cartItems[i].priceBruto * cartItems[i].qty;
      totalNet += lineTotal;
      var lineEl = document.getElementById('qcotc-line-price-' + i);
      if (lineEl) lineEl.textContent = '$' + fmtMiles(lineTotal);
    }
    var totalEl = document.getElementById('qcotc-total-value');
    if (totalEl) totalEl.textContent = '$' + fmtMiles(totalNet);
    updateLease();
  }

  /* ── Update lease preview (solo equipos elegibles) ──────── */
  function updateLease() {
    var arriendo = itemsArriendo();
    var plazoRow = document.getElementById('qcotc-plazo-row');
    var leaseBox = document.getElementById('qcotc-lease-box');

    /* Sin dispositivos elegibles: ocultar el componente de arriendo */
    if (arriendo.length === 0) {
      if (plazoRow) plazoRow.style.display = 'none';
      if (leaseBox) leaseBox.style.display = 'none';
      return;
    }
    if (plazoRow) plazoRow.style.display = '';
    if (leaseBox) leaseBox.style.display = '';

    var totalCuotaNeta = 0;
    var totalEquipos = 0;
    for (var i = 0; i < arriendo.length; i++) {
      totalCuotaNeta += calcCuotaItem(arriendo[i], currentPlazo);
      if (arriendo[i].esDispositivo) totalEquipos += arriendo[i].qty;
    }
    var totalCuotaIVA = totalCuotaNeta * CFG.IVA;

    document.getElementById('qcotc-lease-cuota').textContent = '$' + fmtMiles(totalCuotaIVA) + '/mes';
    var sub = currentPlazo + ' meses · ' + totalEquipos + ' equipo(s) · IVA incluido';
    document.getElementById('qcotc-lease-sub').textContent = sub;
  }

  /* ── Plazo toggle ──────────────────────────────────── */
  document.querySelectorAll('.qcotc-plazo-opt').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.qcotc-plazo-opt').forEach(function(b) { b.classList.remove('qcotc-plazo-active'); });
      btn.classList.add('qcotc-plazo-active');
      currentPlazo = parseInt(btn.getAttribute('data-plazo'), 10);
      updateLease();
    });
  });

  /* ── Create Draft Order via App Proxy ──────────────────── */
  function createDraftOrder(leadData) {
    var hayArriendo = hayDispositivo();

    var items = cartItems.map(function(it) {
      var base = {
        variantId: it.variantId,
        productTitle: it.title,
        variantTitle: it.variantTitle,
        qty: it.qty,
        priceNet: it.priceNet,
        tipoProducto: it.tipo,
        esArriendo: hayArriendo
      };
      if (hayArriendo) {
        base.plazo = currentPlazo;
        base.cuotaNeta = Math.round(calcCuotaItem(it, currentPlazo));
        base.cuotaIVA = Math.round(base.cuotaNeta * CFG.IVA);
      }
      return base;
    });

    var totalNeto = 0;
    var totalCuotaNeta = 0;
    for (var i = 0; i < items.length; i++) {
      totalNeto += items[i].priceNet * items[i].qty;
      if (hayArriendo) {
        totalCuotaNeta += items[i].cuotaNeta;
      }
    }

    var payload = {
      email: leadData.email,
      nombre: leadData.nombre,
      apellido: leadData.apellido,
      empresa: leadData.empresa,
      rut: leadData.rut,
      telefono: leadData.telefono,
      items: items,
      totalNeto: Math.round(totalNeto),
      hayArriendo: hayArriendo,
      plazo: hayArriendo ? currentPlazo : null,
      totalCuotaNeta: hayArriendo ? Math.round(totalCuotaNeta) : null,
      totalCuotaIVA: hayArriendo ? Math.round(totalCuotaNeta * CFG.IVA) : null,
      token: 'CART-' + fmtDateShort().replace(/\//g, '') + '-' + items.length
    };

    console.log('[CotizadorCart] Creando Draft Order...', payload);

    return fetch(APP_PROXY_URL + '/draft-order-cart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(r) {
      if (!r.ok) {
        return r.text().then(function(body) {
          console.warn('[CotizadorCart] Draft Order API error ' + r.status + ':', body);
          throw new Error('Draft order failed: ' + r.status);
        });
      }
      return r.json();
    })
    .then(function(result) {
      if (result.success) {
        console.log('[CotizadorCart] Draft Order creado:', result.draftOrder.name, '— ID:', result.draftOrder.id);
      }
      return result;
    })
    .catch(function(err) {
      console.error('[CotizadorCart] Error creando Draft Order:', err.message);
      /* Fallback: save to cart attributes */
      console.log('[CotizadorCart] Fallback: guardando en cart attributes...');
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          attributes: {
            'cotizacion_email': leadData.email,
            'cotizacion_nombre': ((leadData.nombre || '') + ' ' + (leadData.apellido || '')).trim(),
            'cotizacion_empresa': leadData.empresa || '',
            'cotizacion_rut': leadData.rut || '',
            'cotizacion_telefono': leadData.telefono || '',
            'cotizacion_productos': cartItems.map(function(it) { return it.title; }).join(', '),
            'cotizacion_fecha': fmtDateShort(),
            'cotizacion_tag': 'lead-cotizacion-carrito'
          }
        })
      }).then(function(r) { return r.json(); })
      .then(function(cart) {
        console.log('[CotizadorCart] Fallback OK — cart attributes guardados');
        return cart;
      });
    });
  }

  /* ── Submit handler ────────────────────────────────── */
  var submitBtn = document.getElementById('qcotc-submit-btn');
  var emailInput = document.getElementById('qcotc-email');
  var emailError = document.getElementById('qcotc-email-error');
  var telefonoInput = document.getElementById('qcotc-telefono');
  var telefonoError = document.getElementById('qcotc-telefono-error');

  submitBtn.addEventListener('click', function() {
    var email = emailInput.value.trim();
    var nombre = document.getElementById('qcotc-nombre').value.trim();
    var apellido = document.getElementById('qcotc-apellido').value.trim();
    var empresa = document.getElementById('qcotc-empresa').value.trim();
    var rut = document.getElementById('qcotc-rut').value.trim();
    var telefono = telefonoInput.value.trim();

    /* Validate phone */
    var phoneClean = telefono.replace(/[\s\-\(\)\.]/g, '');
    if (!phoneClean || phoneClean.length < 8) {
      telefonoInput.classList.add('qcotc-input-error');
      telefonoError.classList.add('qcotc-show');
      telefonoInput.focus();
      return;
    }
    telefonoInput.classList.remove('qcotc-input-error');
    telefonoError.classList.remove('qcotc-show');

    if (!isValidEmail(email)) {
      emailInput.classList.add('qcotc-input-error');
      emailError.classList.add('qcotc-show');
      emailInput.focus();
      return;
    }
    emailInput.classList.remove('qcotc-input-error');
    emailError.classList.remove('qcotc-show');

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="qcotc-spinner"></span> Generando cotización...';

    var leadData = { email: email, nombre: nombre, apellido: apellido, empresa: empresa, rut: rut, telefono: telefono };

    /* Fire-and-forget Draft Order */
    createDraftOrder(leadData);

    /* Generate PDF */
    function attemptPDF(retries) {
      if (window.jspdf && window.jspdf.jsPDF) {
        try {
          generateCartPDF(leadData);
          formArea.style.display = 'none';
          successArea.classList.add('qcotc-show');
        } catch(e) {
          console.error('[CotizadorCart] PDF error:', e, e.stack);
          alert('Error al generar el PDF: ' + e.message);
        }
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg> Descargar cotización PDF';
      } else if (retries > 0) {
        setTimeout(function() { attemptPDF(retries - 1); }, 300);
      } else {
        alert('No se pudo cargar la librería PDF. Verifica tu conexión e intenta nuevamente.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg> Descargar cotización PDF';
      }
    }
    attemptPDF(10);
  });

  /* ════════════════════════════════════════════
     PDF GENERATION — formato cotización MacOnline (multi-producto)
     ════════════════════════════════════════════ */
  function generateCartPDF(data) {
    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF('p', 'mm', 'a4');
    var W = 210, H = 297, M = 12, CW = W - 2 * M;

    var headGray = [217, 217, 217];
    var pdfArriendo = itemsArriendo();

    doc.setDrawColor(0, 0, 0);
    doc.setLineWidth(0.3);

    /* ── Logo ─────────────────────────── */
    var logoEl = document.getElementById('qcotc-shop-logo');
    var logoAdded = false;
    if (logoEl && logoEl.complete && logoEl.naturalWidth > 0) {
      try {
        var canvas = document.createElement('canvas');
        canvas.width = logoEl.naturalWidth;
        canvas.height = logoEl.naturalHeight;
        canvas.getContext('2d').drawImage(logoEl, 0, 0);
        var ratio = Math.min(CW / logoEl.naturalWidth, 20 / logoEl.naturalHeight);
        doc.addImage(canvas.toDataURL('image/png'), 'PNG', M, 8, logoEl.naturalWidth * ratio, logoEl.naturalHeight * ratio);
        logoAdded = true;
      } catch(e) { console.warn('Logo insert error:', e); }
    }
    if (!logoAdded) {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(22);
      doc.setTextColor(0, 0, 0);
      doc.text(shopName, M, 20);
    }

    /* ── Bloque razón social ──────────────── */
    var y = 32;
    doc.setTextColor(0, 0, 0);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(13);
    doc.text('ITEM Limitada', M, y);
    y += 5;
    doc.setFontSize(7.5);
    doc.text('RUT 78.936.330-7', M, y); y += 3.8;
    doc.text('EXP, C-VTA EQUIPOS, TELEF- ACCS.SERV, ESTUDIOS, MANT.Y SOPORTE COM.', M, y); y += 3.8;
    doc.text('AV. APOQUINDO 5583, PISO 8, OFICINA 8, COMUNA DE LAS CONDES', M, y);
    y += 9;

    /* ── Tablas de datos: cliente / cotización ── */
    var qNum = String(Date.now()).slice(-6);
    var tW = CW / 2 - 5;
    var contacto = ((data.nombre || '') + ' ' + (data.apellido || '')).trim();
    var leftRows = [
      ['RUT', data.rut || ''],
      ['Cliente', data.empresa || contacto],
      ['Telefono', data.telefono || ''],
      ['Contacto', contacto],
      ['E-Mail', data.email || '']
    ];
    var rightRows = [
      ['Cotización', qNum],
      ['Ejecutivo', ''],
      ['E-Mail', ''],
      ['F. Emisión', fmtDateShort()],
      ['F. Vencimiento', addDays(15)]
    ];
    function infoTable(x, w, rows, startY) {
      var labelW = w * 0.38;
      var rh = 7;
      doc.setFontSize(9);
      for (var i = 0; i < rows.length; i++) {
        var iy = startY + i * rh;
        doc.rect(x, iy, labelW, rh);
        doc.rect(x + labelW, iy, w - labelW, rh);
        doc.setFont('helvetica', 'bold');
        doc.text(rows[i][0], x + 2, iy + 4.8);
        doc.setFont('helvetica', 'normal');
        doc.text(String(rows[i][1] || '').substring(0, 32), x + labelW + 2, iy + 4.8);
      }
      return rows.length * rh;
    }
    var hUsed = infoTable(M, tW, leftRows, y);
    infoTable(M + tW + 10, tW, rightRows, y);
    y += hUsed + 10;

    /* ── Tabla de productos ───────────────── */
    var colW = [30, 14, 78, 24, 18, 22];
    var headers = ['Código', 'Cant.', 'Descripción', 'Precio Unitario', '% Dscto', 'Total Neto'];

    function drawProductHeader(atY) {
      /* primero todas las celdas (el texto en jsPDF pisa el color
         de relleno), luego los titulos */
      doc.setFillColor(headGray[0], headGray[1], headGray[2]);
      var hx = M;
      for (var h = 0; h < headers.length; h++) {
        doc.rect(hx, atY, colW[h], 9, 'FD');
        hx += colW[h];
      }
      hx = M;
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8.5);
      for (var h2 = 0; h2 < headers.length; h2++) {
        doc.text(headers[h2], hx + colW[h2] / 2, atY + 6, { align: 'center' });
        hx += colW[h2];
      }
      return atY + 9;
    }

    function drawColumns(top, height) {
      var cx = M;
      for (var c = 0; c < colW.length; c++) {
        doc.rect(cx, top, colW[c], height);
        cx += colW[c];
      }
    }

    y = drawProductHeader(y);
    var bodyTop = y;
    var rowH = 6.5;
    var maxBodyBottom = 190; /* deja espacio para totales y notas */
    var totalNeto = 0;
    var totalBruto = 0;
    var iy2 = bodyTop + 6;

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);
    for (var i2 = 0; i2 < cartItems.length; i2++) {
      var it2 = cartItems[i2];
      if (iy2 > maxBodyBottom - 2) {
        /* cerrar página y continuar en la siguiente */
        drawColumns(bodyTop, maxBodyBottom - bodyTop);
        doc.addPage();
        y = 15;
        y = drawProductHeader(y);
        bodyTop = y;
        iy2 = bodyTop + 6;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
      }
      var lineNeto = it2.priceNet * it2.qty;
      totalNeto += lineNeto;
      totalBruto += it2.priceBruto * it2.qty;
      var desc2 = it2.title;
      if (it2.variantTitle) desc2 += ' ' + it2.variantTitle;
      if (desc2.length > 45) desc2 = desc2.substring(0, 43) + '...';
      doc.text(String(it2.sku || '').substring(0, 20), M + 2, iy2);
      doc.text(String(it2.qty), M + colW[0] + colW[1] / 2, iy2, { align: 'center' });
      doc.text(desc2, M + colW[0] + colW[1] + 2, iy2);
      doc.text(fmtMiles(it2.priceNet), M + colW[0] + colW[1] + colW[2] + colW[3] - 2, iy2, { align: 'right' });
      doc.text('0,00', M + colW[0] + colW[1] + colW[2] + colW[3] + colW[4] - 2, iy2, { align: 'right' });
      doc.text(fmtMiles(lineNeto), M + CW - 2, iy2, { align: 'right' });
      iy2 += rowH;
    }

    /* cuerpo con altura mínima 60mm en la última página */
    var bodyH = Math.max(60, iy2 - bodyTop + 2);
    if (bodyTop + bodyH > maxBodyBottom) bodyH = maxBodyBottom - bodyTop;
    drawColumns(bodyTop, bodyH);
    y = bodyTop + bodyH + 5;

    /* ── Totales (derecha) ────────────────── */
    var neto = Math.round(totalNeto);
    var total = Math.round(totalBruto);
    var iva = total - neto;
    var boxW = 62, labW = 30;
    var bx = M + CW - boxW;
    var totRows = [
      ['SUB TOTAL', fmtMiles(neto)],
      ['DESCUENTO', '0'],
      ['NETO', fmtMiles(neto)],
      ['IVA', fmtMiles(iva)],
      ['TOTAL', fmtMiles(total)]
    ];
    doc.setFontSize(9);
    for (var t = 0; t < totRows.length; t++) {
      var ty = y + t * 7;
      doc.rect(bx, ty, labW, 7);
      doc.rect(bx + labW, ty, boxW - labW, 7);
      doc.setFont('helvetica', 'bold');
      doc.text(totRows[t][0], bx + 2, ty + 4.8);
      doc.setFont('helvetica', t >= 2 ? 'bold' : 'normal');
      doc.text(totRows[t][1], bx + boxW - 2, ty + 4.8, { align: 'right' });
    }

    /* ── Notas (izquierda) ────────────────── */
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9.5);
    doc.text('"Con OnCare extiende la cobertura frente a fallas hasta por 4 años.', M + 58, y + 5, { align: 'center' });
    doc.text('Consulta por planes disponibles"', M + 58, y + 10, { align: 'center' });

    doc.rect(M, y + 16, 100, 14);
    doc.setFontSize(9);
    doc.text('Renovación de equipos.', M + 3, y + 22);
    doc.text('Consulta por valor de recompra de equipos Apple.', M + 3, y + 27);

    y += 40;

    /* ── Arriendo operativo (si aplica) ───────── */
    if (pdfArriendo.length > 0) {
      var totalCuotaNeta = 0;
      for (var ci = 0; ci < pdfArriendo.length; ci++) {
        totalCuotaNeta += calcCuotaItem(pdfArriendo[ci], currentPlazo);
      }
      var totalCuotaIVA = totalCuotaNeta * CFG.IVA;
      doc.rect(M, y, CW, 13);
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9);
      doc.text('Arriendo Operativo', M + 3, y + 5);
      doc.setFont('helvetica', 'normal');
      doc.text('Plazo ' + currentPlazo + ' meses · Cuota mensual total (IVA incluido): $' + fmtMiles(totalCuotaIVA) + '/mes', M + 3, y + 10);
      y += 18;
    }

    /* ── Consideraciones ──────────────────── */
    var terms;
    if (pdfArriendo.length > 0) {
      terms = [
        '1- El arriendo operativo es una alternativa de financiamiento para empresas e instituciones.',
        '2- Las cuotas incluyen el uso del equipo durante el plazo contratado.',
        '3- Esta cotización tiene una vigencia de 15 días desde la fecha de emisión.',
        '4- Los valores son referenciales y pueden estar sujetos a aprobación crediticia.',
        '* Recuerde revisar nuestros términos y condiciones, publicados en nuestra web https://www.maconline.com/condiciones'
      ];
    } else {
      terms = [
        '1- Esta cotización tiene una vigencia de 15 días desde la fecha de emisión.',
        '2- El plazo de entrega está sujeto a disponibilidad al momento de realizar el pago.',
        '3- Los valores son referenciales y están sujetos a disponibilidad de stock.',
        '* Recuerde revisar nuestros términos y condiciones, publicados en nuestra web https://www.maconline.com/condiciones'
      ];
    }
    var termsH = 7 + terms.length * 4 + 3;
    if (y + termsH > H - 18) { doc.addPage(); y = 15; }
    doc.rect(M, y, CW, termsH);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8.5);
    doc.text('Consideraciones', M + 2, y + 5);
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(7.5);
    var ly = y + 9.5;
    for (var t2 = 0; t2 < terms.length; t2++) {
      doc.text(terms[t2], M + 2, ly);
      ly += 4;
    }
    y += termsH;

    /* ── Pie de página ────────────────────── */
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.text('MacOnline - Avenida Apoquindo 5583 - Las Condes - Santiago de Chile - 25623200', W / 2, H - 10, { align: 'center' });

    /* ── Save ───────────────────────────── */
    var fileName = 'Cotizacion_' + qNum + '_' + fmtDateShort().replace(/\//g, '') + '.pdf';
    doc.save(fileName);
  }

  /* ── Initialize ────────────────────────────────────── */
  /* Inject button on DOMContentLoaded and also after AJAX cart updates */
  function init() {
    injectButton();
    /* Re-inject after Shopify's cart updates (for dynamically reloaded drawers) */
    var observer = new MutationObserver(function() {
      setTimeout(injectButton, 200);
    });
    var drawerEl = document.querySelector('cart-drawer');
    if (drawerEl) {
      observer.observe(drawerEl, { childList: true, subtree: true });
    }
    var cartItemsEl = document.querySelector('cart-items');
    if (cartItemsEl) {
      observer.observe(cartItemsEl, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>
