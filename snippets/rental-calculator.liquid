{%- liquid
  comment
    El arriendo operativo solo aplica a estos tipos de producto:
    iPhone, iPad, Mac Desktop (iMac / Mac mini / Mac Studio / Mac Pro)
    y Mac Notebook (MacBook Air / MacBook Pro).
    Para el resto de productos el widget no se renderiza.
  endcomment
  assign qrw_tipo = ''
  assign qrw_pt = product.type | default: '' | strip
  assign qrw_p4 = qrw_pt | slice: 0, 4
  assign qrw_p6 = qrw_pt | slice: 0, 6
  assign qrw_p7 = qrw_pt | slice: 0, 7
  if qrw_p6 == 'iPhone'
    assign qrw_tipo = 'iPhone'
  elsif qrw_p4 == 'iPad'
    assign qrw_tipo = 'iPad'
  elsif qrw_p7 == 'MacBook'
    assign qrw_tipo = 'Mac Notebook'
  elsif qrw_p4 == 'iMac' or qrw_pt == 'Mac mini' or qrw_pt == 'Mac Studio' or qrw_pt == 'Mac Pro'
    assign qrw_tipo = 'Mac Desktop'
  endif
-%}
{%- if qrw_tipo != blank -%}
{% render 'arriendo-config' %}
<div class="qrw" data-rental-calculator data-tipo-arriendo="{{ qrw_tipo }}">
  <div class="qrw-cuota-section" aria-live="polite">
    <p class="qrw-eyebrow">Arri&eacute;ndalo desde</p>
    <div class="qrw-price-row">
      <span class="qrw-cuota">$<span id="qrw-cuota">0</span></span>
      <span class="qrw-cuota-suffix">/por mes</span>
    </div>
    <p class="qrw-meta" id="qrw-meta">12 meses &middot; 1 equipo &middot; IVA incluido</p>
  </div>

  <p class="qrw-plazo-label" id="qrw-plazo-label">Plazo</p>
  <div class="qrw-plazos" role="group" aria-labelledby="qrw-plazo-label">
    {% for months in (1..3) %}
      {% liquid
        case months
          when 1
            assign term = 12
          when 2
            assign term = 24
          else
            assign term = 36
        endcase
      %}
      <button
        class="qrw-plazo{% if term == 12 %} is-active{% endif %}"
        id="qrw-p{{ term }}"
        type="button"
        aria-pressed="{% if term == 12 %}true{% else %}false{% endif %}"
        data-term="{{ term }}"
      >
        <span class="qrw-plazo-num">{{ term }} meses</span>
        <span class="qrw-plazo-sub">Valor de cuota $<span data-term-price="{{ term }}">0</span></span>
      </button>
    {% endfor %}
  </div>
</div>

<script>
  (() => {
    const calculator = document.querySelector('[data-rental-calculator]');
    if (!calculator || calculator.dataset.initialized === 'true') return;
    calculator.dataset.initialized = 'true';

    const CFG = window.ArriendoConfig;
    const factors = CFG.grupoFactores(calculator.dataset.tipoArriendo);
    const variants = {{ product.variants | json }};
    let selectedTerm = 12;

    const formatAmount = (amount) => Math.round(amount).toLocaleString('es-CL');
    const quantityInput = () => document.querySelector('form[action*="/cart/add"] input[name="quantity"]');
    const selectedVariant = () => {
      const variantInput = document.querySelector('form[action*="/cart/add"] input[name="id"]');
      return variants.find((variant) => String(variant.id) === variantInput?.value) || variants[0];
    };

    /* Los precios del e-commerce YA incluyen IVA; por linealidad
       cuota (IVA incl.) = precio (IVA incl.) x factor */
    const calculatePayment = (term) => {
      const quantity = Math.max(1, Number.parseInt(quantityInput()?.value || '1', 10));
      const price = (selectedVariant()?.price || {{ product.price }}) / 100;
      return price * quantity * factors[term];
    };

    const render = () => {
      const quantity = Math.max(1, Number.parseInt(quantityInput()?.value || '1', 10));
      const payment = calculatePayment(selectedTerm);

      calculator.querySelector('#qrw-cuota').textContent = formatAmount(payment);
      calculator.querySelector('#qrw-meta').textContent = `${selectedTerm} meses · ${quantity} ${quantity === 1 ? 'equipo' : 'equipos'} · IVA incluido`;

      Object.keys(factors).forEach((term) => {
        calculator.querySelector(`[data-term-price="${term}"]`).textContent = formatAmount(calculatePayment(term));
      });
    };

    calculator.querySelectorAll('.qrw-plazo').forEach((button) => {
      button.addEventListener('click', () => {
        selectedTerm = Number.parseInt(button.dataset.term, 10);
        calculator.querySelectorAll('.qrw-plazo').forEach((termButton) => {
          const isActive = termButton === button;
          termButton.classList.toggle('is-active', isActive);
          termButton.setAttribute('aria-pressed', String(isActive));
        });
        render();
      });
    });

    document.addEventListener('change', (event) => {
      if (event.target.matches('variant-selects select, variant-radios input, input[name="quantity"]')) {
        window.setTimeout(render, 0);
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target.closest('quantity-input button')) window.setTimeout(render, 0);
    });

    render();
  })();
</script>
{%- endif -%}
