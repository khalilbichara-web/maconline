{% case status %}
  {% when 'cross' %}
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/>
      <path d="M5.5 5.5L10.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M10.5 5.5L5.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  {% when 'warning' %}
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8.68 2.24L14.26 12.16C14.62 12.8 14.16 13.6 13.42 13.6H2.26C1.52 13.6 1.06 12.8 1.42 12.16L7 2.24C7.36 1.6 8.32 1.6 8.68 2.24Z" stroke="currentColor" stroke-width="1.2"/>
      <path d="M8 5.5V9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="8" cy="11.2" r="0.8" fill="currentColor"/>
    </svg>
  {% else %}
  {% when 'empty' %}
  {% else %}
    <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/>
      <path d="M4.8 8.1L7 10.3L11.3 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{% endcase %}
