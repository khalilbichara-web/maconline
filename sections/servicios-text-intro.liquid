{{ 'section-servicios-text-intro.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<section class="servicios-text-intro servicios-text-intro--{{ section.settings.alignment }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding section-{{ section.id }}-margin">
  <div class="servicios-text-intro__container">
    <div class="servicios-text-intro__inner">
      {% if section.settings.subheading != blank %}
        <div class="servicios-text-intro__subheading-wrap">
          <span class="servicios-text-intro__dot" aria-hidden="true"></span>
          <p class="servicios-text-intro__subheading subheading">{{ section.settings.subheading }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="servicios-text-intro__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="servicios-text-intro__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Servicios Text Intro",
  "tag": "section",
  "class": "servicios-text-intro-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-3"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SERVICIO TÉCNICO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reparaciones certificadas <span>Apple.</span>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Centro de servicio técnico autorizado con técnicos certificados Apple. Piezas originales, tiempos garantizados y seguimiento en tiempo real de tu equipo.</p>"
    },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Padding top",
      "default": "l",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ]
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": "m",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ]
    },
    {
      "type": "select",
      "id": "margin_top",
      "label": "Margin top",
      "default": "no-indent",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ]
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "default": "no-indent",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Servicios Text Intro"
    }
  ]
}
{% endschema %}