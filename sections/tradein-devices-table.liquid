          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_key": "mac",
            "tab_label": "Mac",
            "rows": "MacBook Pro 16\" M3 Max|Estado A|$2.100.000\nMacBook Pro 14\" M3 Pro|Estado A|$1.480.000\nMacBook Air 15\" M3|Estado A|$940.000\nMacBook Air 13\" M2|Estado B|$640.000\niMac 24\" M3|Estado A|$960.000\nMac mini M2 Pro|Estado B|$540.000\nMac Studio M2 Max|Estado B|$1.200.000"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_key": "ipad",
