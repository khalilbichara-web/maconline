{{ 'section-tradein-devices-table.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tradein-devices-table.js' | asset_url }}" defer></script>

{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
-%}

<section class="tradein-devices-table" data-tradein-devices-table>
  <div class="tradein-devices-table__container">
    <header class="tradein-devices-table__header">
      {% if section.settings.subheading != blank %}
        <div class="tradein-devices-table__subheading-wrap">
          <span class="tradein-devices-table__dot" aria-hidden="true"></span>
          <p class="tradein-devices-table__subheading">{{ section.settings.subheading }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tradein-devices-table__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="tradein-devices-table__description">{{ section.settings.description }}</p>
      {% endif %}
    </header>

    {% if tabs.size > 0 %}
      <div class="tradein-devices-table__panel-wrap">
        {% for block in tabs %}
          {%- liquid
            assign rows = block.settings.rows | newline_to_br | split: '<br />'
          -%}
          <div
            class="tradein-devices-table__panel{% if forloop.first %} is-active{% endif %}"
            data-tradein-panel="{{ forloop.index0 }}"
            role="tabpanel"
            id="tradein-panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-labelledby="tradein-tab-{{ section.id }}-{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="tradein-devices-table__table-head" role="row">
              <div class="tradein-devices-table__col tradein-devices-table__col--model">Modelo</div>
              <div class="tradein-devices-table__col tradein-devices-table__col--condition">Condición</div>
              <div class="tradein-devices-table__col tradein-devices-table__col--credit">Crédito estimado</div>
            </div>

            <div class="tradein-devices-table__table-body">
              {% for row in rows %}
                {% assign trimmed = row | strip %}
                {% if trimmed != blank %}
                  {% assign fields = trimmed | split: '|' %}
                  <div class="tradein-devices-table__row" role="row">
                    <div class="tradein-devices-table__col tradein-devices-table__col--model">{{ fields[0] | default: '' | strip }}</div>
                    <div class="tradein-devices-table__col tradein-devices-table__col--condition">{{ fields[1] | default: '' | strip }}</div>
                    <div class="tradein-devices-table__col tradein-devices-table__col--credit">{{ fields[2] | default: '' | strip }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="tradein-devices-table__tabs" role="tablist" aria-label="Categorías de equipos">
        {% for block in tabs %}
          <button
            type="button"
            class="tradein-devices-table__tab-btn{% if forloop.first %} is-active{% endif %}"
            data-tradein-target="{{ forloop.index0 }}"
            role="tab"
            id="tradein-tab-{{ section.id }}-{{ forloop.index0 }}"
            aria-controls="tradein-panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            <span class="tradein-devices-table__tab-icon" aria-hidden="true">
              {% case block.settings.tab_key %}
                {% when 'iphone' %}
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="6" y="2.5" width="8" height="15" rx="2.2" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="14.8" r="0.8" fill="currentColor"/></svg>
                {% when 'mac' %}
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="14" height="10" rx="1.6" stroke="currentColor" stroke-width="1.4"/><path d="M1.8 16.2H18.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                {% when 'ipad' %}
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4.6" y="2.4" width="10.8" height="15.2" rx="1.8" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="14.9" r="0.7" fill="currentColor"/></svg>
                {% else %}
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5.3" y="2.8" width="9.4" height="14.4" rx="4.7" stroke="currentColor" stroke-width="1.4"/><path d="M10 6.4V10.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              {% endcase %}
            </span>
            <span>{{ block.settings.tab_label }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="tradein-devices-table__note">{{ section.settings.note }}</p>
    {% endif %}

    {% if section.settings.slides_link_label != blank %}
      <div class="tradein-devices-table__footer-link-wrap">
        <a href="{{ section.settings.slides_link_url | default: '#' }}" class="tradein-devices-table__footer-link">
          {{ section.settings.slides_link_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Trade In devices table",
  "tag": "section",
  "class": "section-tradein-devices-table",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "catálogo trade in"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Dispositivos aceptados"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descripción",
      "default": "Aceptamos la mayoría de los modelos Apple en dos condiciones: A (excelente estado) y B (buen estado con uso normal)."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota inferior",
      "default": "* Valores de referencia en CLP. El crédito definitivo se determina tras evaluación en tienda o visita técnica. Válido por 14 días desde la cotización."
    },
    {
      "type": "text",
      "id": "slides_link_label",
      "label": "Texto enlace a más slides",
      "default": "Ver más tablas por categoría"
    },
    {
      "type": "url",
      "id": "slides_link_url",
      "label": "URL enlace a más slides"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "tab_key",
          "label": "Tipo de tab",
          "options": [
            { "value": "iphone", "label": "iPhone" },
            { "value": "mac", "label": "Mac" },
            { "value": "ipad", "label": "iPad" },
            { "value": "watch", "label": "Apple Watch" }
          ],
          "default": "iphone"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Etiqueta",
          "default": "iPhone"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Filas (formato: Modelo|Condición|Crédito)",
          "default": "iPhone 16 Pro Max 256 GB|Estado A|$820.000\niPhone 16 Pro 128 GB|Estado A|$710.000\niPhone 15 Pro Max 256 GB|Estado A|$680.000\niPhone 15 Pro 128 GB|Estado A|$620.000\niPhone 15 128 GB|Estado B|$380.000\niPhone 14 Pro 128 GB|Estado B|$320.000\niPhone 14 128 GB|Estado B|$240.000\niPhone 13 128 GB|Estado B|$160.000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade In devices table",
      "category": "Custom",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_key": "iphone",
            "tab_label": "iPhone",
