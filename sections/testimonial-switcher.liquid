{{ 'section-testimonial-switcher.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonial-switcher.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  class="testimonial-switcher color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding"
  {% if section.settings.custom_id != blank %}
    id="{{ section.settings.custom_id }}"
  {% endif %}
>
  <div class="container">
    {% if section.blocks.size > 0 %}
      <testimonial-switcher class="testimonial-switcher__wrapper">
        <div class="testimonial-switcher__card">
          <div class="testimonial-switcher__panels">
            {%- for block in section.blocks -%}
              <div
                class="testimonial-switcher__panel{% if forloop.first %} is-active{% endif %}"
                data-testimonial-panel="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                <div class="testimonial-switcher__content">
                  {%- if block.settings.logo != blank -%}
                    <div class="testimonial-switcher__logo">
                      {{
                        block.settings.logo
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', widths: '200, 300, 400'
                      }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <p class="testimonial-switcher__text">&ldquo;{{ block.settings.text }}&rdquo;</p>
                  {%- endif -%}

                  {%- if block.settings.rating > 0 -%}
                    <div class="testimonial-switcher__rating">
                      <div class="testimonial-switcher__stars">
                        <i class="icon-star"></i>
                      </div>
                      <div class="testimonial-switcher__rating-count body-small">
                        {{ block.settings.rating | append: '.00' }}
                      </div>
                    </div>
                  {%- endif -%}
                </div>

                <div class="testimonial-switcher__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'testimonial-switcher__image',
                        loading: 'lazy',
                        widths: '480, 750, 960, 1200',
                        sizes: '(min-width: 750px) 50vw, 100vw'
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg testimonial-switcher__image' }}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {% if section.blocks.size > 0 %}
          <div class="testimonial-switcher__tabs" role="tablist">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="testimonial-switcher__tab{% if forloop.first %} is-active{% endif %}"
                data-testimonial-tab="{{ forloop.index0 }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {%- if block.settings.logo != blank -%}
                  <span class="testimonial-switcher__tab-logo testimonial-switcher__tab-logo--on">
                    {{ block.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
                  </span>
                {%- endif -%}
                {%- if block.settings.logo_off != blank -%}
                  <span class="testimonial-switcher__tab-logo testimonial-switcher__tab-logo--off">
                    {{ block.settings.logo_off | image_url: width: 200 | image_tag: loading: 'lazy' }}
                  </span>
                {%- elsif block.settings.logo != blank -%}
                  <span class="testimonial-switcher__tab-logo testimonial-switcher__tab-logo--off">
                    {{ block.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {% endif %}
      </testimonial-switcher>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Testimonial switcher",
  "tag": "section",
  "class": "section-testimonial-switcher",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "ID del contenedor (para enlaces internos)",
      "info": "Se usa como atributo id de la sección, por ejemplo para enlazar con #mi-id desde un botón o menú."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-padding.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-padding.options__6.label" }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-padding.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-padding.options__6.label" }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (encendido)",
          "info": "Se usa en el testimonio activo y en el tab cuando está seleccionado."
        },
        {
          "type": "image_picker",
          "id": "logo_off",
          "label": "Logo apagado",
          "info": "Versión atenuada/outline del logo, usada en el tab cuando NO está seleccionado. Si se deja vacío, se reutiliza el logo encendido."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonio",
          "default": "MacOnline nos apoya siempre que necesitamos comprar grandes cantidades de equipos de una forma súper ágil y nos deja tranquilos saber que siempre es así. Es un proveedor estratégico para nuestro equipo."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Calificación"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial switcher",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
