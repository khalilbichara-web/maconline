{{ 'section-image-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-carousel.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="image-carousel color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="image-carousel__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="image-carousel__slider-wrapper">
        <div
          class="image-carousel__slider swiper"
          data-columns="{{ section.settings.columns_desktop }}"
          data-gap="{{ section.settings.gap }}"
          data-autoplay="{{ section.settings.autoplay }}"
          data-autoplay-speed="{{ section.settings.autoplay_speed }}"
          data-loop="{{ section.settings.enable_loop }}"
          data-navigation="{{ section.settings.show_navigation }}"
          data-pagination="{{ section.settings.show_pagination }}"
        >
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="image-carousel__slide swiper-slide" {{ block.shopify_attributes }}>
                {%- assign media_class = 'image-carousel__media image-carousel__media--' | append: section.settings.image_ratio -%}
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="{{ media_class }}"
                    style="border-radius: {{ section.settings.corner_radius }}px;"
                    {% if settings.links_blank and block.settings.link.type == 'external_link' and block.settings.link != '#' %}
                      target="_blank"
                    {% endif %}
                  >
                {%- else -%}
                  <div class="{{ media_class }}" style="border-radius: {{ section.settings.corner_radius }}px;">
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 90vw',
                      widths: '375, 550, 750, 1100, 1500'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {% if section.settings.show_pagination %}
          <div class="image-carousel__pagination swiper-pagination color-{{ section.settings.color_scheme }} no-js-hidden"></div>
        {% endif %}

        {% if section.settings.show_navigation %}
          <div class="image-carousel__navigation swiper-navigation no-js-hidden">
            <div class="image-carousel__button-prev swiper-button-prev color-{{ section.settings.color_scheme }}">
              {% render 'icon-caret-left' %}
            </div>
            <div class="image-carousel__button-next swiper-button-next color-{{ section.settings.color_scheme }}">
              {% render 'icon-caret-right' %}
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-carousel.name",
  "tag": "section",
  "class": "section-image-carousel spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.image-carousel.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-carousel.settings.header__layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.image-carousel.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.image-carousel.settings.gap.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-carousel.settings.image_ratio.options__1.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.image-carousel.settings.image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.image-carousel.settings.image_ratio.options__3.label"
        },
        {
          "value": "square",
          "label": "t:sections.image-carousel.settings.image_ratio.options__4.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.image-carousel.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 8,
      "unit": "px",
      "label": "t:sections.image-carousel.settings.corner_radius.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-carousel.settings.header__behavior.content"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.image-carousel.settings.show_navigation.label"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "default": true,
      "label": "t:sections.image-carousel.settings.show_pagination.label"
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "default": false,
      "label": "t:sections.image-carousel.settings.enable_loop.label"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": false,
      "label": "t:sections.image-carousel.settings.autoplay.label"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "label": "t:sections.image-carousel.settings.autoplay_speed.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-padding.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-padding.options__6.label" }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-padding.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-padding.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-padding.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-padding.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-padding.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-padding.options__6.label" }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.image-carousel.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image-carousel.blocks.slide.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.image-carousel.blocks.slide.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-carousel.name",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
