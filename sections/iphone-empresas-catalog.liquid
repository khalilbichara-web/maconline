{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-iphone-empresas-catalog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cards = section.blocks | where: 'type', 'product_card'
-%}

<section
  class="iphone-empresas-catalog section-{{ section.id }}-padding"
  {% if section.settings.custom_id != blank %}
    id="{{ section.settings.custom_id }}"
  {% endif %}
>
  <div class="iphone-empresas-catalog__container">
    <div class="iphone-empresas-catalog__header">
      {% if section.settings.subheading != blank %}
        <div class="iphone-empresas-catalog__subheading-wrap">
          <span class="iphone-empresas-catalog__dot" aria-hidden="true"></span>
          <p class="iphone-empresas-catalog__subheading">{{ section.settings.subheading }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="iphone-empresas-catalog__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="iphone-empresas-catalog__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if cards.size > 0 %}
      <div class="iphone-empresas-catalog__grid">
        {% for block in cards %}
          {%- liquid
            assign card_product = block.settings.product
            assign card_image_override = block.settings.image_override
            assign list_items = block.settings.list_items | newline_to_br | split: '<br />'
          -%}
          <article class="iphone-empresas-catalog__card" {{ block.shopify_attributes }}>
            <div class="iphone-empresas-catalog__media">
              {% if card_image_override != blank %}
                {% if card_product != blank and card_product.url != blank %}
                  <a href="{{ card_product.url }}" class="iphone-empresas-catalog__media-link" aria-label="{{ block.settings.title | default: card_product.title | escape }}">
                    {{
                      card_image_override
                      | image_url: width: 1000
                      | image_tag:
                        class: 'iphone-empresas-catalog__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 22vw, 90vw',
                        alt: block.settings.title | default: card_product.title
                    }}
                  </a>
                {% else %}
                  {{
                    card_image_override
                    | image_url: width: 1000
                    | image_tag:
                      class: 'iphone-empresas-catalog__image',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 22vw, 90vw',
                      alt: block.settings.title
                  }}
                {% endif %}
              {% elsif card_product != blank and card_product.featured_media != blank %}
                <a href="{{ card_product.url }}" class="iphone-empresas-catalog__media-link" aria-label="{{ block.settings.title | default: card_product.title | escape }}">
                  {{
                    card_product.featured_media
                    | image_url: width: 1000
                    | image_tag:
                      class: 'iphone-empresas-catalog__image',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 22vw, 90vw',
                      alt: card_product.title
                  }}
                </a>
              {% else %}
                <div class="iphone-empresas-catalog__placeholder" aria-hidden="true">
                  {{ 'product-1' | placeholder_svg_tag: 'iphone-empresas-catalog__image' }}
                </div>
              {% endif %}
            </div>

            <div class="iphone-empresas-catalog__content">
              {% if block.settings.title != blank %}
                <h3 class="iphone-empresas-catalog__title">{{ block.settings.title }}</h3>
              {% elsif card_product != blank %}
                <h3 class="iphone-empresas-catalog__title">{{ card_product.title }}</h3>
              {% endif %}

              {% if block.settings.subtitle != blank %}
                <p class="iphone-empresas-catalog__subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}

              <div class="iphone-empresas-catalog__price-wrap">
                {% if block.settings.price_label != blank %}
                  <span class="iphone-empresas-catalog__price-label">{{ block.settings.price_label }}</span>
                {% endif %}

                {% if card_product != blank %}
                  <div class="iphone-empresas-catalog__price">
                    {{ card_product.price | money }}
                    <span>/mes</span>
                  </div>
                {% elsif block.settings.price_fallback != blank %}
                  <div class="iphone-empresas-catalog__price iphone-empresas-catalog__price--fallback">
                    {{ block.settings.price_fallback }}
                  </div>
                {% endif %}
              </div>

              {% if list_items.size > 0 %}
                <ul class="iphone-empresas-catalog__list" role="list">
                  {% for item in list_items %}
                    {% assign text = item | strip %}
                    {% if text != blank %}
                      <li class="iphone-empresas-catalog__list-item">{{ text }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <div class="iphone-empresas-catalog__actions">
                  {% render 'button',
                    link: card_product.url,
                    label: block.settings.button_label,
                    style: block.settings.button_style,
                    class: 'iphone-empresas-catalog'
                  %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="iphone-empresas-catalog__note">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "iPhone empresas catálogo",
  "tag": "section",
  "class": "section-iphone-empresas-catalog",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "ID del contenedor (para enlaces internos)",
      "info": "Se usa como atributo id de la sección, por ejemplo para enlazar con #mi-id desde un botón o menú."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "catálogo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Elige tu iPhone"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descripción",
      "default": "Todos los modelos incluyen garantía Apple, soporte prioritario y entrega en 24 horas en Santiago."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota inferior",
      "default": "* Precios referenciales por unidad para contratos de 24 meses. Descuentos por volumen disponibles."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Tarjeta de producto",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "image_picker",
          "id": "image_override",
          "label": "Imagen override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "iPhone 15"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "128 GB · Dynamic Island"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Etiqueta de precio",
          "default": "Desde"
        },
        {
          "type": "text",
          "id": "price_fallback",
          "label": "Precio de respaldo",
          "default": "$19.990/mes"
        },
        {
          "type": "textarea",
          "id": "list_items",
          "label": "Lista de elementos",
          "default": "Chip A16 Bionic\nCámara 48 MP principal\nDynamic Island\nUSB-C\nGarantía Apple 1 año"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "Cotizar para mi empresa"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo del botón",
          "options": [
            { "value": "primary", "label": "Primario" },
            { "value": "secondary", "label": "Secundario" },
            { "value": "tertiary", "label": "Terciario" },
            { "value": "simple", "label": "Simple" },
            { "value": "simple_secondary", "label": "Simple secundario" },
            { "value": "simple_link", "label": "Simple link" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "iPhone empresas catálogo",
      "category": "Custom",
      "settings": {
        "subheading": "catálogo",
        "heading": "Elige tu iPhone",
        "description": "Todos los modelos incluyen garantía Apple, soporte prioritario y entrega en 24 horas en Santiago.",
        "note": "* Precios referenciales por unidad para contratos de 24 meses. Descuentos por volumen disponibles."
      },
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "title": "iPhone 15",
            "subtitle": "128 GB · Dynamic Island",
            "price_label": "Desde",
            "price_fallback": "$19.990/mes",
            "list_items": "Chip A16 Bionic\nCámara 48 MP principal\nDynamic Island\nUSB-C\nGarantía Apple 1 año",
            "button_label": "Cotizar para mi empresa",
            "button_style": "primary"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "iPhone 16 Pro",
            "subtitle": "255 GB · Titanio Natural",
            "price_label": "Desde",
            "price_fallback": "$34.990/mes",
            "list_items": "Chip A18 Pro con IA\nCámara Fusión 48 MP\nProRes Video 4k 120fps\nAction Button\nCamera Control\nGarantía Apple 1 año",
            "button_label": "Cotizar para mi empresa",
            "button_style": "primary"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "iPhone 16 Pro Max",
            "subtitle": "256 GB · Titanio Negro",
            "price_label": "Desde",
            "price_fallback": "$42.990/mes",
            "list_items": "Chip A18 Pro con IA\nPantalla 6.9\" ProMotion\nBatería de 33h de video\nZoom óptico 5x\nGarantía Apple 1 año",
            "button_label": "Cotizar para mi empresa",
            "button_style": "primary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
