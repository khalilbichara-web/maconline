{{ 'section-portal-admin-scope.css' | asset_url | stylesheet_tag }}

<section class="portal-admin-scope">
  <div class="portal-admin-scope__container">
    <div class="portal-admin-scope__left">
      {% if section.settings.subheading != blank %}
        <div class="portal-admin-scope__subheading-wrap">
          <span class="portal-admin-scope__dot"></span>
          <p class="portal-admin-scope__subheading">{{ section.settings.subheading }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="portal-admin-scope__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="portal-admin-scope__description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="portal-admin-scope__lists">
      {%- assign list_col_1 = section.settings.list_col_1 | newline_to_br | split: '<br />' -%}
      {%- assign list_col_2 = section.settings.list_col_2 | newline_to_br | split: '<br />' -%}

      <ul class="portal-admin-scope__list" role="list">
        {% for item in list_col_1 %}
          {% assign text = item | strip %}
          {% if text != blank %}
            <li>
              <span class="portal-admin-scope__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M5.25 8.1L7.25 10.1L10.85 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{{ text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      <ul class="portal-admin-scope__list" role="list">
        {% for item in list_col_2 %}
          {% assign text = item | strip %}
          {% if text != blank %}
            <li>
              <span class="portal-admin-scope__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M5.25 8.1L7.25 10.1L10.85 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{{ text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portal Admin Scope",
  "tag": "section",
  "class": "portal-admin-scope-section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "¿QUÉ PUEDES ADMINISTRAR?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Centraliza la gestión de identidades en toda tu organización."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Con Apple Accounts para Empresas es posible administrar:"
    },
    {
      "type": "textarea",
      "id": "list_col_1",
      "label": "Lista columna 1 (una línea por ítem)",
      "default": "Identidades digitales corporativas\nUsuarios y colaboradores.\nAccesos a aplicaciones empresariales.\nDispositivos asociados.\nRoles administrativos."
    },
    {
      "type": "textarea",
      "id": "list_col_2",
      "label": "Lista columna 2 (una línea por ítem)",
      "default": "Integración con directorios corporativos.\nCiclo de vida de los usuarios.\nPolíticas de autenticación\nAccesos y permisos."
    }
  ],
  "presets": [
    {
      "name": "Portal Admin Scope"
    }
  ]
}
{% endschema %}
