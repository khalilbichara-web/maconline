{{ 'section-split-features.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout       = section.settings.layout | default: 'image_left'
  assign color_scheme = section.settings.color_scheme | default: 'light'
  assign badges       = section.blocks | where: 'type', 'badge'
  assign features     = section.blocks | where: 'type', 'feature'
-%}

<div class="split-features split-features--{{ layout }} split-features--{{ color_scheme }}">
  <div class="split-features__container">

    <!-- ── Media column ────────────────────────────── -->
    <div class="split-features__media">
      {%- liquid
        if section.settings.image != blank or section.settings.image_asset != blank
          assign image_wrap_class = 'split-features__image-wrap'
        else
          assign image_wrap_class = 'split-features__image-wrap split-features__image-wrap--placeholder'
        endif
      -%}
      <div class="{{ image_wrap_class }}">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'split-features__image',
              loading: 'lazy',
              widths: '400, 600, 900'
          }}
        {% elsif section.settings.image_asset != blank %}
          {% comment %} theme-check-disable ImgWidthAndHeight {% endcomment %}
          <img
            src="{{ section.settings.image_asset | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="split-features__image"
            loading="lazy"
            width="900"
            height="600"
          >
          {% comment %} theme-check-enable ImgWidthAndHeight {% endcomment %}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'split-features__image' }}
        {% endif %}

        {% if badges.size > 0 %}
          <ul class="split-features__badges" role="list">
            {% for block in badges %}
              <li class="split-features__badge split-features__badge--{{ forloop.index }}" {{ block.shopify_attributes }}>
                {% if block.settings.icon_name != blank %}
                  <img
                    src="{{ block.settings.icon_name | asset_url }}"
                    alt=""
                    width="20"
                    height="20"
                    loading="lazy"
                  >
                {% endif %}
                <span>{{ block.settings.label }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>

    <!-- ── Content column ─────────────────────────── -->
    <div class="split-features__content">

      {% if section.settings.subheading != blank %}
        <div class="split-features__subheading-wrapper">
          <div class="split-features__subheading-dot"></div>
          <p class="split-features__subheading">{{ section.settings.subheading }}</p>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="split-features__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="split-features__description{% if template.suffix == 'portal-empresas-mdm' %} split-features__description--portal-empresas-mdm{% endif %}">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if features.size > 0 %}
        <div class="split-features__grid">
          {% for block in features %}
            <div class="split-features__feature" {{ block.shopify_attributes }}>
              <div class="split-features__feature-top">
                {% if block.settings.icon_name != blank %}
                  <div class="split-features__feature-icon">
                    <img
                      src="{{ block.settings.icon_name | asset_url }}"
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                {% if block.settings.number != blank %}
                  <span class="split-features__feature-number">{{ block.settings.number }}</span>
                {% endif %}
              </div>
              <div class="split-features__feature-body">
                {% if block.settings.heading != blank %}
                  <h3 class="split-features__feature-heading">{{ block.settings.heading }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="split-features__feature-description">{{ block.settings.description }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- if section.settings.show_button and section.settings.button_label != blank -%}
        <div class="split-features__buttons">
          {% render 'button',
            link: section.settings.button_link,
            label: section.settings.button_label,
            style: section.settings.button_style,
            class: 'split-features'
          %}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split Features",
  "tag": "section",
  "class": "split-features-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "light", "label": "Claro (blanco)" },
        { "value": "dark",  "label": "Oscuro" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "image_left",  "label": "Imagen a la izquierda" },
        { "value": "image_right", "label": "Imagen a la derecha" }
      ],
      "default": "image_left"
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen principal"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Imagen desde assets",
      "info": "Ingresa el nombre del archivo en assets, por ejemplo: portal-empresas-mdm-figma-1-5402.png"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "RENTAL OPERATIVO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Deja de comprar tecnología. Empieza a administrarla de forma inteligente"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Transforma la adquisición de dispositivos Apple en un servicio integral que combina financiamiento, soporte, administración y renovación, permitiendo que tu empresa crezca con una infraestructura tecnológica siempre actualizada.</p>"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botón",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Explorar rental operativo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "URL del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        { "group": "Filled",  "value": "primary",         "label": "Primary" },
        { "group": "Filled",  "value": "secondary",       "label": "Secondary" },
        { "group": "Filled",  "value": "tertiary",        "label": "Tertiary" },
        { "group": "Simple",  "value": "simple",          "label": "Simple" },
        { "group": "Simple",  "value": "simple_secondary","label": "Simple secondary" },
        { "group": "Simple",  "value": "simple_link",     "label": "Link" }
      ],
      "default": "primary"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge flotante",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Ícono",
          "options": [
            { "value": "",                                 "label": "— Sin ícono —" },
            { "value": "solar_shield-check-outline.svg",  "label": "Escudo / Seguridad" },
            { "value": "solar_graph-down-new-outline.svg","label": "Gráfico / Depreciación" },
            { "value": "solar_clock-circle-outline.svg",  "label": "Reloj / Tiempo" },
            { "value": "solar_chart-outline.svg",         "label": "Chart / Escalabilidad" }
          ],
          "default": ""
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto del badge",
          "default": "Beneficio"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Ícono",
          "options": [
            { "value": "",                                 "label": "— Sin ícono —" },
            { "value": "solar_shield-check-outline.svg",  "label": "Escudo / Seguridad" },
            { "value": "solar_graph-down-new-outline.svg","label": "Gráfico / Depreciación" },
            { "value": "solar_clock-circle-outline.svg",  "label": "Reloj / Tiempo" },
            { "value": "solar_chart-outline.svg",         "label": "Chart / Escalabilidad" }
          ],
          "default": ""
        },
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "info": "Opcional. Se muestra como etiqueta destacada en la tarjeta."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Título del feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Descripción breve del beneficio."
        }
      ]
    }
  ]
}
{% endschema %}
