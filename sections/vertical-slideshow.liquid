{{ 'section-vertical-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vertical-slideshow.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-padding' %}
	{% render 'section-margin' %}
{%- endstyle -%}

<section class="vertical-slideshow color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding section-{{ section.id }}-margin{% if section.settings.force_light_mode %} vertical-slideshow--force-light{% endif %}" data-vertical-slideshow>
	<div class="vertical-slideshow__container">
		<div class="vertical-slideshow__header">
			{% if section.settings.subheading != blank %}
				<div class="vertical-slideshow__subheading-wrap">
					<span class="vertical-slideshow__dot"></span>
					<p class="subtitle vertical-slideshow__subheading">{{ section.settings.subheading }}</p>
				</div>
			{% endif %}

			{% if section.settings.heading != blank %}
				<h2 class="vertical-slideshow__heading">{{ section.settings.heading }}</h2>
			{% endif %}

			{% if section.settings.description != blank %}
				<div class="vertical-slideshow__description">{{ section.settings.description }}</div>
			{% endif %}
		</div>

		<div class="vertical-slideshow__body">
			<div class="vertical-slideshow__nav" role="tablist" aria-label="Vertical slideshow navigation">
				{% for block in section.blocks %}
					<div class="vertical-slideshow__nav-item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
						<button
							type="button"
							class="vertical-slideshow__nav-btn"
							role="tab"
							aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
							aria-controls="vertical-slideshow-panel-{{ section.id }}-{{ forloop.index }}"
							data-index="{{ forloop.index0 }}"
						>
							<div class="vertical-slideshow__nav-head">
								<span class="vertical-slideshow__number">{{ forloop.index }}</span>
								<span class="vertical-slideshow__label">{{ block.settings.label }}</span>
							</div>
						</button>

						<div class="vertical-slideshow__detail">
							{{ block.settings.details }}
						</div>

						<div class="vertical-slideshow__mobile-visual" aria-hidden="true">
							<div class="vertical-slideshow__mobile-image-wrap vertical-slideshow__mobile-image-wrap--{{ forloop.index }}">
								{% if block.settings.image != blank %}
									{{
										block.settings.image
										| image_url: width: 1000
										| image_tag:
											class: 'vertical-slideshow__mobile-image',
											loading: 'lazy',
											widths: '320,420,560,720,900,1000'
									}}
								{% elsif block.settings.image_asset != blank %}
									<img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="lazy" class="vertical-slideshow__mobile-image" width="728" height="326">
								{% endif %}
							</div>

							<div class="vertical-slideshow__mobile-pills">
								{% for i in (1..5) %}
									{%- liquid
										assign pill_text_key = 'pill_' | append: i | append: '_text'
										assign pill_icon_key = 'pill_' | append: i | append: '_icon'
										assign pill_text = block.settings[pill_text_key]
										assign pill_icon = block.settings[pill_icon_key]
									-%}
									{% if pill_text != blank %}
										<div class="vertical-slideshow__pill vertical-slideshow__pill--{{ i }}">
											{% if pill_icon != blank %}
												<span class="vertical-slideshow__pill-icon">
													{{
														pill_icon
														| image_url: width: 24
														| image_tag:
															loading: 'lazy',
															widths: '16,24,32',
															alt: ''
													}}
												</span>
											{% endif %}
											<span>{{ pill_text }}</span>
										</div>
									{% endif %}
								{% endfor %}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>

			<div class="vertical-slideshow__visual">
				{% for block in section.blocks %}
					<div
						id="vertical-slideshow-panel-{{ section.id }}-{{ forloop.index }}"
						class="vertical-slideshow__panel vertical-slideshow__panel--{{ forloop.index }}{% if forloop.first %} is-active{% endif %}"
						role="tabpanel"
						aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
					>
						<div class="vertical-slideshow__image-wrap vertical-slideshow__image-wrap--{{ forloop.index }}">
							{% if block.settings.image != blank %}
								{{
									block.settings.image
									| image_url: width: 1000
									| image_tag:
										class: 'vertical-slideshow__image',
										loading: 'lazy',
										widths: '420,560,720,900,1000'
								}}
							{% elsif block.settings.image_asset != blank %}
								<img src="{{ block.settings.image_asset | asset_url }}" alt="" loading="lazy" class="vertical-slideshow__image" width="728" height="326">
							{% endif %}
						</div>

						<div class="vertical-slideshow__pills">
							{% for i in (1..5) %}
								{%- liquid
									assign pill_text_key = 'pill_' | append: i | append: '_text'
									assign pill_icon_key = 'pill_' | append: i | append: '_icon'
									assign pill_text = block.settings[pill_text_key]
									assign pill_icon = block.settings[pill_icon_key]
								-%}
								{% if pill_text != blank %}
									<div class="vertical-slideshow__pill vertical-slideshow__pill--{{ i }}">
										{% if pill_icon != blank %}
											<span class="vertical-slideshow__pill-icon">
												{{
													pill_icon
													| image_url: width: 24
													| image_tag:
														loading: 'lazy',
														widths: '16,24,32',
														alt: ''
												}}
											</span>
										{% endif %}
										<span>{{ pill_text }}</span>
									</div>
								{% endif %}
							{% endfor %}
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</section>

{% schema %}
{
	"name": "Vertical Slideshow",
	"tag": "section",
	"class": "vertical-slideshow-section",
	"enabled_on": {
		"templates": ["*"]
