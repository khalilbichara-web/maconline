{% doc %}
  @prompt
    Hola, quiero hacer un carrousel de colecciones con imagenes 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-collection-carousel-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-collection-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_desktop }});
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
  }

  .ai-collection-carousel-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    text-decoration: none;
    height: 100%;
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-collection-carousel-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-carousel-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_title_size }}px;
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-collection-carousel-collection-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_description_size }}px;
    margin: 0;
    opacity: 0.9;
  }

  .ai-collection-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_color }};
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-collection-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-collection-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-collection-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-collection-carousel-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-collection-carousel-empty-title-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 8px;
    color: #333;
  }

  .ai-collection-carousel-empty-text-{{ ai_gen_id }} {
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_mobile }});
    }

    .ai-collection-carousel-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-collection-carousel-collection-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.collection_title_size }}px * 0.85);
    }

    .ai-collection-carousel-collection-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.collection_description_size }}px * 0.85);
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-columns-desktop="{{ block.settings.columns_desktop }}"
  data-columns-mobile="{{ block.settings.columns_mobile }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  {% if block.settings.heading != blank %}
    <div class="ai-collection-carousel-header-{{ ai_gen_id }}">
      <h2 class="ai-collection-carousel-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  {% assign has_collections = false %}
  {% for i in (1..8) %}
    {% assign collection_key = 'collection_' | append: i %}
    {% if block.settings[collection_key] != blank %}
      {% assign has_collections = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_collections %}
    <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
      <div class="ai-collection-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign collection_key = 'collection_' | append: i %}
          {% assign collection = block.settings[collection_key] %}
          
          {% if collection != blank %}
            <div class="ai-collection-carousel-item-{{ ai_gen_id }}">
              <a href="{{ collection.url }}" class="ai-collection-carousel-link-{{ ai_gen_id }}">
                <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
                  {% if collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 800 }}"
                      alt="{{ collection.image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    >
                  {% elsif collection.products.first and collection.products.first.featured_image %}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                      alt="{{ collection.products.first.featured_image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    >
                  {% else %}
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  {% endif %}
                  
                  {% if block.settings.show_overlay %}
                    <div class="ai-collection-carousel-overlay-{{ ai_gen_id }}"></div>
                  {% endif %}
                  
                  <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
                    <h3 class="ai-collection-carousel-collection-title-{{ ai_gen_id }}">
                      {{ collection.title }}
                    </h3>
                    {% if block.settings.show_description and collection.description != blank %}
                      <p class="ai-collection-carousel-collection-description-{{ ai_gen_id }}">
                        {{ collection.description | strip_html | truncate: 80 }}
                      </p>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-collection-carousel-controls-{{ ai_gen_id }}">
        <button
          class="ai-collection-carousel-button-{{ ai_gen_id }} ai-collection-carousel-prev-{{ ai_gen_id }}"
          aria-label="Anterior"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-collection-carousel-dots-{{ ai_gen_id }}"></div>

        <button
          class="ai-collection-carousel-button-{{ ai_gen_id }} ai-collection-carousel-next-{{ ai_gen_id }}"
          aria-label="Siguiente"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  {% else %}
    <div class="ai-collection-carousel-empty-{{ ai_gen_id }}">
      <h3 class="ai-collection-carousel-empty-title-{{ ai_gen_id }}">Carrusel de colecciones</h3>
      <p class="ai-collection-carousel-empty-text-{{ ai_gen_id }}">Selecciona colecciones para mostrar en el carrusel</p>
    </div>
  {% endif %}
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel-track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-collection-carousel-item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-collection-carousel-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-collection-carousel-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-collection-carousel-dots-{{ ai_gen_id }}');
        
        if (!this.track || this.items.length === 0) return;

        this.columnsDesktop = parseInt(this.dataset.columnsDesktop);
        this.columnsMobile = parseInt(this.dataset.columnsMobile);
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed);

        this.setupCarousel();
        this.setupEventListeners();
        this.updateCarousel();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupCarousel() {
        const columns = window.innerWidth > 749 ? this.columnsDesktop : this.columnsMobile;
        this.totalPages = Math.ceil(this.items.length / columns);

        if (this.dotsContainer) {
          this.dotsContainer.innerHTML = '';
          for (let i = 0; i < this.totalPages; i++) {
            const dot = document.createElement('button');
            dot.className = 'ai-collection-carousel-dot-{{ ai_gen_id }}';
            dot.setAttribute('aria-label', `Ir a página ${i + 1}`);
            dot.addEventListener('click', () => this.goToPage(i));
            this.dotsContainer.appendChild(dot);
          }
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        window.addEventListener('resize', () => {
          this.setupCarousel();
          this.updateCarousel();
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      prev() {
        this.currentIndex = Math.max(0, this.currentIndex - 1);
        this.updateCarousel();
      }

      next() {
        this.currentIndex = Math.min(this.totalPages - 1, this.currentIndex + 1);
        this.updateCarousel();
      }

      goToPage(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const columns = window.innerWidth > 749 ? this.columnsDesktop : this.columnsMobile;
        const offset = -(this.currentIndex * 100);
        this.track.style.transform = `translateX(${offset}%)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.totalPages - 1;
        }

        const dots = this.querySelectorAll('.ai-collection-carousel-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          if (this.currentIndex < this.totalPages - 1) {
            this.next();
          } else {
            this.currentIndex = 0;
            this.updateCarousel();
          }
        }, this.autoplaySpeed * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carrusel de colecciones",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
